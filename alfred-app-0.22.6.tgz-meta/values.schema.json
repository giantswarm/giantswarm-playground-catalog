{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "affinity": {
            "type": "object",
            "additionalProperties": false
        },
        "baseDomain": {
            "type": "string"
        },
        "bootstrapMode": {
            "type": "object",
            "additionalProperties": true
        },
        "chartOperator": {
            "type": "object",
            "additionalProperties": true
        },
        "ciliumNetworkPolicy": {
            "type": "object",
            "additionalProperties": true
        },
        "cluster": {
            "type": "object",
            "additionalProperties": true
        },
        "clusterCA": {
            "type": "string"
        },
        "clusterCIDR": {
            "type": "string"
        },
        "clusterDNSIP": {
            "type": "string"
        },
        "clusterID": {
            "type": "string"
        },
        "cortex": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "password": {
                    "type": "string"
                },
                "url": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                }
            }
        },
        "fullnameOverride": {
            "type": "string"
        },
        "gcpProject": {
            "type": "string"
        },
        "global": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "podSecurityStandards": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "enforced": {
                            "type": "boolean"
                        }
                    }
                }
            }
        },
        "grafanaAgent": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "resources": {
                    "type": "object",
                    "description": "Resources for the `grafana-agent` metrics sidecar, which scrapes the app and ships the samples to Grafana Cloud.",
                    "additionalProperties": false,
                    "properties": {
                        "limits": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "ephemeral-storage": {
                                    "type": "string",
                                    "description": "Ephemeral storage limit for the sidecar. Deliberate headroom over an already time-bounded WAL: `max_wal_time` defaults to 4h and truncates even while `remote_write` is behind, so the WAL cannot grow without end."
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        },
                        "requests": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "ephemeral-storage": {
                                    "type": "string",
                                    "description": "Ephemeral storage request for the sidecar. Required by the `require-emptydir-requests-and-limits` policy, because this is the container that mounts the `agent-wal` `emptyDir`."
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "image": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string"
                },
                "pullPolicy": {
                    "type": "string"
                },
                "registry": {
                    "type": "string"
                },
                "tag": {
                    "type": "string"
                }
            }
        },
        "imagePullSecrets": {
            "type": "array"
        },
        "nameOverride": {
            "type": "string"
        },
        "nodeSelector": {
            "type": "object",
            "additionalProperties": false
        },
        "pagerduty": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "afternoonShift": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "probeHour": {
                            "type": "integer"
                        },
                        "scheduleID": {
                            "type": "string"
                        }
                    }
                },
                "morningShift": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "probeHour": {
                            "type": "integer"
                        },
                        "scheduleID": {
                            "type": "string"
                        }
                    }
                },
                "token": {
                    "type": "string"
                }
            }
        },
        "podSecurityContext": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "fsGroup": {
                    "type": "integer"
                },
                "runAsGroup": {
                    "type": "integer"
                },
                "runAsNonRoot": {
                    "type": "boolean"
                },
                "runAsUser": {
                    "type": "integer"
                }
            }
        },
        "prometheusRule": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "maxDaysWithoutSuccess": {
                    "type": "integer"
                },
                "team": {
                    "type": "string"
                }
            }
        },
        "provider": {
            "type": "string"
        },
        "replicaCount": {
            "type": "integer"
        },
        "reporter": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "schedule": {
                        "type": "string"
                    },
                    "url": {
                        "type": "string"
                    }
                }
            }
        },
        "resources": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "limits": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "ephemeral-storage": {
                            "type": "string",
                            "description": "Ephemeral storage limit. The app itself opens nothing on disk and logs to stdout, so this covers the runtime's rotated container logs."
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                },
                "requests": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "ephemeral-storage": {
                            "type": "string",
                            "description": "Ephemeral storage request. Declared so the pod-level budget, which kubelet sums from the containers, is chosen here rather than inherited from the sidecar alone."
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "securityContext": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "allowPrivilegeEscalation": {
                    "type": "boolean"
                },
                "capabilities": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "drop": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "privileged": {
                    "type": "boolean"
                },
                "seccompProfile": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "service": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "type": {
                    "type": "string"
                },
                "port": {
                    "type": "integer"
                }
            }
        },
        "serviceAccount": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "create": {
                    "type": "boolean"
                },
                "name": {
                    "type": "null"
                }
            }
        },
        "slack": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "excludedChannels": {
                    "type": "array",
                    "description": "Support channels Alfred ignores entirely: channels used for tests, and channels of customers that are not onboarded yet. They look exactly like a live customer channel, so only this list can tell them apart. Full channel names, with or without the leading \"#\", e.g. \"support-acme\".",
                    "items": {
                        "type": "string"
                    }
                },
                "reportingChannel": {
                    "type": "string"
                },
                "signingSecret": {
                    "type": "string"
                },
                "slackToken": {
                    "type": "string"
                }
            }
        },
        "subscriptionID": {
            "type": "string"
        },
        "timeZone": {
            "type": "string"
        },
        "tolerations": {
            "type": "array"
        }
    }
}
